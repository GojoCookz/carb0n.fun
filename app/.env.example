# Copy to .env and fill in. .env is gitignored; never commit a real key.
#
# ---------------------------------------------------------------------------------------------
# NOTHING IN THIS FILE IS A SECRET, AND THAT IS THE POINT.
#
# Vite inlines every VITE_-prefixed variable into the built JavaScript, so anything here is
# readable by anyone who opens devtools on the deployed site. This file previously held
# VITE_PINATA_JWT, which meant a live upload credential shipped to every visitor.
#
# Uploads now go to an endpoint we control. Its URL is public; the key it holds is not.
# See `server/pin.ts` for the reference implementation, and set PINATA_JWT in the SERVER
# environment - never in a VITE_ variable.
# ---------------------------------------------------------------------------------------------

# Where the app POSTs images to be pinned. Leave empty and the launch form will say uploads are
# unavailable and take a CID directly, which is the honest degraded state rather than a broken
# button.
#
# Local:  bun server/pin.ts   ->  http://localhost:8787
VITE_PIN_ENDPOINT=

# WalletConnect / Reown project id. Free, from https://cloud.reown.com.
#
# NOT A SECRET - it identifies the app to the WalletConnect relay and is visible in any session
# QR code. It belongs in a VITE_ variable, unlike the Pinata key above.
#
# WITHOUT IT, WALLETCONNECT IS SILENTLY ABSENT RATHER THAN BROKEN. `isConfigured()` returns false,
# the connect menu never offers it, and desktop extensions keep working exactly as before. The
# cost of leaving it empty is that PHONES CANNOT CONNECT AT ALL: a mobile browser has no injected
# provider, so WalletConnect is the only route that exists there.
#
# Restrict the id to the deployed origins in the Reown dashboard once set.
VITE_WALLETCONNECT_PROJECT_ID=
